{
  "info": {
    "name": "Phase 1.12 - Category User Product Inventory API Review",
    "description": "Sequential API smoke tests. Requires app at localhost:8080 and an existing role ID 1. Change testEmail and testSku before rerunning to avoid duplicate data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"categoryId","value":""},
    {"key":"userId","value":""},
    {"key":"productId","value":""},
    {"key":"inventoryId","value":""},
    {"key":"testEmail","value":"p112-test-user@example.com"},
    {"key":"testSku","value":"P112-TEST-SKU-001"}
  ],
  "item": [
    {"name":"01 Category - create","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/categories","body":{"mode":"raw","raw":"{\n  \"name\": \"P112 Test Accessories\",\n  \"description\": \"Phase 1.12 test category\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 201',()=>pm.response.to.have.status(201));","const j=pm.response.json(); pm.expect(j.name).to.eql('P112 Test Accessories'); pm.collectionVariables.set('categoryId',j.id);"]}}]},
    {"name":"02 Category - get by ID","request":{"method":"GET","url":"{{baseUrl}}/api/categories/{{categoryId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"03 Category - list","request":{"method":"GET","url":"{{baseUrl}}/api/categories"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json()).to.be.an('array');"]}}]},
    {"name":"04 Category - update","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/categories/{{categoryId}}","body":{"mode":"raw","raw":"{\n  \"name\": \"P112 Test Accessories Updated\",\n  \"description\": \"Updated test category\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"05 User - create","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users","body":{"mode":"raw","raw":"{\n  \"name\": \"P112 Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"TemporaryPass123!\",\n  \"roleId\": 1\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 201',()=>pm.response.to.have.status(201));","const j=pm.response.json(); pm.expect(j).not.to.have.property('password'); pm.collectionVariables.set('userId',j.id);"]}}]},
    {"name":"06 User - get by ID","request":{"method":"GET","url":"{{baseUrl}}/api/users/{{userId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"07 User - list","request":{"method":"GET","url":"{{baseUrl}}/api/users"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json()).to.be.an('array');"]}}]},
    {"name":"08 User - update","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users/{{userId}}","body":{"mode":"raw","raw":"{\n  \"name\": \"P112 Updated User\",\n  \"email\": \"{{testEmail}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"09 Product - create","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/products","body":{"mode":"raw","raw":"{\n  \"name\": \"P112 Test Keyboard\",\n  \"description\": \"Smoke test product\",\n  \"sku\": \"{{testSku}}\",\n  \"price\": 4500,\n  \"categoryId\": {{categoryId}}\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('productId',pm.response.json().id);"]}}]},
    {"name":"10 Product - get by ID","request":{"method":"GET","url":"{{baseUrl}}/api/products/{{productId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"11 Product - list","request":{"method":"GET","url":"{{baseUrl}}/api/products"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json()).to.be.an('array');"]}}]},
    {"name":"12 Product - update","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/products/{{productId}}","body":{"mode":"raw","raw":"{\n  \"name\": \"P112 Updated Keyboard\",\n  \"description\": \"Updated test product\",\n  \"sku\": \"{{testSku}}\",\n  \"price\": 4750,\n  \"categoryId\": {{categoryId}}\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"13 Inventory - create","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/inventory","body":{"mode":"raw","raw":"{\n  \"productId\": {{productId}},\n  \"quantity\": 10\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 201',()=>pm.response.to.have.status(201));","const j=pm.response.json(); pm.expect(j.quantity).to.eql(10); pm.expect(j.reservedQuantity).to.eql(0); pm.expect(j.availableQuantity).to.eql(10); pm.collectionVariables.set('inventoryId',j.id);"]}}]},
    {"name":"14 Inventory - get by ID","request":{"method":"GET","url":"{{baseUrl}}/api/inventory/{{inventoryId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"15 Inventory - get by product ID","request":{"method":"GET","url":"{{baseUrl}}/api/inventory/product/{{productId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"16 Inventory - list","request":{"method":"GET","url":"{{baseUrl}}/api/inventory"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json()).to.be.an('array');"]}}]},
    {"name":"17 Inventory - update stock","request":{"method":"PUT","url":"{{baseUrl}}/api/inventory/{{inventoryId}}/stock?quantity=15"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json().quantity).to.eql(15);"]}}]},
    {"name":"18 Expected 404 - unknown product","request":{"method":"GET","url":"{{baseUrl}}/api/products/99999999"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 404',()=>pm.response.to.have.status(404));","pm.expect(pm.response.json().status).to.eql(404);"]}}]},
    {"name":"19 Expected 409 - duplicate SKU","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/products","body":{"mode":"raw","raw":"{\n  \"name\": \"Duplicate SKU check\",\n  \"description\": \"Expected conflict\",\n  \"sku\": \"{{testSku}}\",\n  \"price\": 100,\n  \"categoryId\": {{categoryId}}\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 409',()=>pm.response.to.have.status(409));"]}}]},
    {"name":"20 Expected 409 - duplicate inventory","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/inventory","body":{"mode":"raw","raw":"{\n  \"productId\": {{productId}},\n  \"quantity\": 3\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 409',()=>pm.response.to.have.status(409));"]}}]}
  ]
}
